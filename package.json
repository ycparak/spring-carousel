{
	"name": "@ycparak/spring-carousel",
	"version": "0.1.0",
	"description": "A composable, spring-driven carousel for React.",
	"keywords": [
		"react",
		"carousel",
		"slider",
		"spring",
		"tabs",
		"gesture",
		"drag"
	],
	"author": "Yusuf Parak",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bunchee",
		"dev": "bunchee --watch",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "vitest run",
		"doctor": "react-doctor . --no-supply-chain --verbose",
		"prepare": "bunchee",
		"prepublishOnly": "bun run typecheck && bun run lint && bun run test && bun run doctor && bun run build"
	},
	"peerDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"bunchee": "^7.0.2",
		"happy-dom": "^21.0.3",
		"react": "^19.3.1",
		"react-doctor": "^0.9.18",
		"react-dom": "^19.3.1",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	}
}
